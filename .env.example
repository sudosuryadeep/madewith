# Google Cloud OAuth 2.0 (Gmail API, read-only scope)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
# Optional; default is Google OAuth Playground redirect URI
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Telegram bot token from @BotFather, and target group ID (often negative)
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=-1001234567890

# Upstash Redis REST credentials (deduplication across serverless runs)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Protect the endpoint. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=make-a-long-random-secret

# Optional Gmail search query; keep it narrow to avoid forwarding unrelated email
GMAIL_SEARCH_QUERY=newer_than:2d (from:famapp.in OR from:famapp.com) (subject:received OR subject:payment OR "successfully received")